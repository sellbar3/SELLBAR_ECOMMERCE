PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/sellbar
JWT_ACCESS_SECRET=sellbar_super_secret_jwt_key_min_32_characters_long_12345
JWT_ACCESS_EXPIRES=1d
BCRYPT_ROUNDS=10
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Initial Admin Bootstrap
ADMIN_EMAIL=admin@sellbar.com
ADMIN_PASSWORD=admin1234
ADMIN_NAME=SELLBAR Admin

# Cloudinary (Optional for uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Razorpay (Optional for payments)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

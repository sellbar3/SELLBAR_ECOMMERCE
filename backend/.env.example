NODE_ENV=production
PORT=5000

# MongoDB database
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.foqbgdq.mongodb.net/sellbar?retryWrites=true&w=majority

# Frontend URLs allowed for CORS & Redirection
CLIENT_URL=https://sellbar.in,https://www.sellbar.in,http://localhost:3000,http://localhost:5173
CORS_ORIGINS=https://sellbar.in,https://www.sellbar.in,http://localhost:3000,http://localhost:5173

# Server Domain & API Gateway
API_URL=https://app.sellbar.in/api

# JWT security
JWT_ACCESS_SECRET=sellbar_super_secret_jwt_key_min_32_characters_long_12345
JWT_ACCESS_EXPIRES=1d
BCRYPT_ROUNDS=10

# Initial Admin Bootstrap
ADMIN_NAME=SELLBAR Admin
ADMIN_EMAIL=admin@sellbar.com
ADMIN_PASSWORD=admin1234

# Cloudinary image storage (Optional for uploads)
CLOUDINARY_CLOUD_NAME=dbd4anwt
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Razorpay payment gateway (Optional for payments)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
